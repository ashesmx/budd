# Copy to .env, then `chmod 600 .env` (it holds a secret). docker-compose
# (hosted mode) reads it, and so does `npm start`.

# docker-compose already forces hosted mode. Outside Docker, set this to try
# hosted mode locally; without it, `npm start` runs local mode.
# BUDD_MODE=hosted

# The URL people and MCP clients use to reach Budd (https, no path).
PUBLIC_URL=https://budd.example.com

# Sign-in with Google: an OAuth client of type "Web application" whose
# authorized redirect URI is ${PUBLIC_URL}/auth/callback.
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me
# Who may sign in: everyone who does gets a workspace, so Budd won't start
# until you set one of these (docs/operating.md, "Who may sign in").
# Email addresses, or @domains, with any provider:
# ALLOWED_EMAILS=you@example.com,@example.org
# Google Workspace domains, even if the Google project's audience is Internal:
# ALLOWED_HD=example.com
# Or anyone your provider accepts, for an instance meant for the public:
# OPEN_SIGNUP=true

# Behind a proxy or tunnel, the header that carries the client's address, so
# rate limits apply per client (docs/operating.md, "Putting Budd on the
# internet"): x-forwarded-for (Caddy), x-real-ip (nginx), cf-connecting-ip
# (Cloudflare Tunnel). Set it only if clients can't send that header
# themselves: behind a CDN's proxy plus your own, see the docs first.
# CLIENT_IP_HEADER=x-real-ip

# Or any other OpenID Connect provider instead of Google:
# OIDC_ISSUER=https://login.example.com
# OIDC_CLIENT_ID=...
# OIDC_CLIENT_SECRET=...

# Docker only: the host port Budd is published on (always on 127.0.0.1).
# BUDD_PORT=8787

# When a workspace's audit log reaches MAX_AUDIT_MB, Budd refuses its agents
# until there's room; only you, not the people using Budd, can change that.
# On an instance shared by several people, let it delete the oldest entries
# instead. Leave it off if your organisation must keep a full year of audit.
# AUDIT_ROTATE=true

# Wake-ups: Budd POSTs to an agent's platform when its mailbox has mail
# (docs/integrations/wake-ups.md). Set off to stop them all.
# WAKE_UPS=on
# The only hosts wake-ups may go to (default: Claude Code routines, Grok Bot,
# Multica's cloud). List them all to add one; * allows any public host.
# WAKE_UP_HOSTS=api.anthropic.com,api2.cursor.sh,grok.com,multica.ai
# The most wake-ups one mailbox gets in an hour.
# WAKE_UPS_PER_HOUR=30
# Locks wake-up addresses, tokens and signing secrets, so the data directory
# or a backup alone can't open them. Generate with: openssl rand -hex 32
# Keep a copy off the server (docs/operating.md, Backups). To change it, set
# the old one as BUDD_SECRET_KEY_PREVIOUS for one restart.
# BUDD_SECRET_KEY=
# BUDD_SECRET_KEY_PREVIOUS=

# Optional overrides (defaults shown).
# DELIVERY_TTL=1d
# MAX_DELIVERY_TTL=7d
# SWEEP_INTERVAL=1m
# RETENTION_TTL=30d
# AUDIT_TTL=1y
# SEND_RATE_PER_MIN=5
# SENDER_MAX_OUTSTANDING=100
# RECIPIENT_MAX_UNREAD=100
# INBOX_MAX_LIMIT=50
# MAX_HANDLES_PER_CONNECTION=25
# MAX_MESSAGE_BYTES=32768
# MAX_CONNECTIONS_PER_WORKSPACE=50
# MAX_WORKSPACE_MB=100
# MAX_AUDIT_MB=500
# IP_RATE_PER_MIN=120
# MCP_RATE_PER_MIN=120
# UI_RATE_PER_MIN=300
# KEY_IDLE_EXPIRY=30d
